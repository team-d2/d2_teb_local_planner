  <arg name="teb_params" default="$(var project_share)/config/teb_param.yaml" />

  <arg name="points_topic" default="/velodyne_points" />

  <arg name="global_plan_topic" default="/waypoint_path_teb" />
  <arg name="odom_topic" default="/predicted_odom" />
  <arg name="obstacles_topic" default="/obstacles" />

